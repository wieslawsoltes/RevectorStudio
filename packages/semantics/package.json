{
  "name": "@revector/semantics",
  "version": "0.4.0",
  "type": "module",
  "description": "Transactional semantic rule engine for vector-first PDF to semantic DXF conversion",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@revector/model": "0.4.0",
    "@revector/geometry": "0.4.0",
    "@revector/topology": "0.4.0",
    "@revector/pdf": "0.4.0"
  }
}
