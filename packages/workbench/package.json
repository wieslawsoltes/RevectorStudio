{
  "name": "@revector/workbench",
  "version": "0.6.0",
  "type": "module",
  "description": "Compact two-panel conversion IDE for vector-first PDF to semantic DXF conversion",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./*": "./src/*",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@revector/engine": "0.6.0",
    "@revector/renderer": "0.6.0",
    "@revector/ui": "0.6.0",
    "@revector/geometry": "0.6.0",
    "@revector/model": "0.6.0",
    "@revector/dxf": "0.6.0",
    "@revector/pdf": "0.6.0",
    "@revector/rules-cad": "0.6.0",
    "@revector/semantics": "0.6.0",
    "@revector/ocr": "0.6.0",
    "@revector/rules-document": "0.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/RevectorStudio.git",
    "directory": "packages/workbench"
  }
}
