{
  "name": "revector-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Vector-first PDF to semantic DXF conversion workbench",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "prepare": "node scripts/link-workspaces.mjs",
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tests/browser.py",
    "test:dxf": "python tests/validate_dxf.py",
    "pack:all": "node scripts/pack.mjs",
    "convert": "node scripts/convert.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --lib ES2023,DOM examples/integration.ts",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "test:extensions": "python tests/extensions_browser.py",
    "test:recovery": "python tests/recovery_browser.py",
    "test:images": "python tests/images_browser.py",
    "test:images:cli": "python tests/images_cli.py"
  },
  "optionalDependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.8.3",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "@napi-rs/canvas": "0.1.80"
  }
}
